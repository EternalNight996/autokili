<?xml version="1.0" encoding="utf-8"?>
<!--
  AutoKill MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build autokill.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc autokill.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\AutoKill by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch AutoKill" box. Installs a Start Menu shortcut and an
  App Paths entry (Win+R "autokill"), plus autokill-cli when HasCli=1. No file types are
  claimed: AutoKill opens anything, so it never takes over another app's default.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for AutoKill forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="AutoKill"
      Manufacturer="EternalNight996"
      Version="$(var.Version)"
      UpgradeCode="35D7C00B-6982-4C87-B6FD-E33F52A07519"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="AutoKill: find out how any software works" Manufacturer="EternalNight996" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of AutoKill is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="AutoKillIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AutoKillIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/EternalNight996/autokill" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/EternalNight996/autokill" />
    <Property Id="ARPHELPLINK" Value="https://github.com/EternalNight996/autokill/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AutoKill" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by AutoKillApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\AutoKill" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="AutoKill" Level="1">
      <ComponentGroupRef Id="AutoKillFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAutoKill"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through autokill.en-us.wxl. -->
    <Property Id="AutoKillVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="AutoKill $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch AutoKill" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AutoKillExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchAutoKill" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AutoKillFiles" Directory="INSTALLFOLDER">
      <Component Id="AutoKillApp" Guid="60FCAC4D-3674-43B5-824E-D73D95F95627">
        <File Id="AutoKillExe" Source="$(var.BinDir)\autokill.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="AutoKill"
              Description="Find out how any software works, then craft your own" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="AutoKillIcon.exe" IconIndex="0" />
        </File>

        <!-- The "Open with" app list (any file) and the Run dialog (Win+R "autokill"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\autokill.exe" Name="FriendlyAppName" Value="AutoKill" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\autokill.exe\shell\open\command" Value="&quot;[#AutoKillExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\autokill.exe" Value="[#AutoKillExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\AutoKill" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="AutoKillCli">
        <File Id="AutoKillCliExe" Source="$(var.BinDir)\autokill-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
